<!DOCTYPE html>
<html lang="fr" xmlns:th="http://www.thymeleaf.org">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard - Cinema Admin</title>
    
    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    
    <!-- Custom CSS -->
    <link rel="stylesheet" th:href="@{/css/admin.css}">
</head>
<body>
    <div class="d-flex" id="wrapper">
        <!-- Sidebar -->
        <div class="bg-dark border-end" id="sidebar-wrapper">
            <div class="sidebar-heading border-bottom bg-danger">
                <i class="bi bi-film me-2"></i>
                <span class="fw-bold">CINEMA ADMIN</span>
            </div>
            <div class="list-group list-group-flush">
                <a th:href="@{/admin/dashboard}" 
                   class="list-group-item list-group-item-action bg-dark text-light active">
                    <i class="bi bi-speedometer2 me-2"></i>Dashboard
                </a>
                <a th:href="@{/admin/films}" 
                   class="list-group-item list-group-item-action bg-dark text-light">
                    <i class="bi bi-camera-reels me-2"></i>Films
                </a>
                <a th:href="@{/admin/salles}" 
                   class="list-group-item list-group-item-action bg-dark text-light">
                    <i class="bi bi-door-open me-2"></i>Salles
                </a>
                <a th:href="@{/seances}" 
                   class="list-group-item list-group-item-action bg-dark text-light">
                    <i class="bi bi-calendar-event me-2"></i>Séances
                </a>
                <a href="#" class="list-group-item list-group-item-action bg-dark text-light">
                    <i class="bi bi-ticket-perforated me-2"></i>Réservations
                </a>
                <a href="#" class="list-group-item list-group-item-action bg-dark text-light">
                    <i class="bi bi-people me-2"></i>Clients
                </a>
                <a href="#" class="list-group-item list-group-item-action bg-dark text-light">
                    <i class="bi bi-graph-up me-2"></i>Statistiques
                </a>
                <a href="#" class="list-group-item list-group-item-action bg-dark text-light">
                    <i class="bi bi-gear me-2"></i>Paramètres
                </a>
            </div>
        </div>

        <!-- Page Content -->
        <div id="page-content-wrapper">
            <!-- Top Navbar -->
            <nav class="navbar navbar-dark bg-netflix border-bottom">
                <div class="container-fluid">
                    <button class="btn btn-danger" id="sidebarToggle">
                        <i class="bi bi-list"></i>
                    </button>
                    <div class="d-flex align-items-center">
                        <span class="navbar-text text-light me-3">
                            <i class="bi bi-person-circle me-1"></i>
                            Administrateur
                        </span>
                        <button class="btn btn-outline-light btn-sm">
                            <i class="bi bi-box-arrow-right"></i>
                        </button>
                    </div>
                </div>
            </nav>

            <!-- Main Content -->
            <div class="container-fluid p-4">
                <!-- Header -->
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h1 class="text-light"><i class="bi bi-speedometer2 me-2"></i>Tableau de Bord</h1>
                    <span class="text-muted" th:text="${#temporals.format(#temporals.createNow(), 'dd MMMM yyyy', new java.util.Locale('fr'))}"></span>
                </div>

                <!-- Statistics Cards -->
                <div class="row g-4 mb-4">
                    <div class="col-xl-3 col-md-6">
                        <div class="card netflix-card text-light border-0 h-100">
                            <div class="card-body">
                                <div class="d-flex justify-content-between align-items-start">
                                    <div>
                                        <p class="text-muted mb-1">Total Films</p>
                                        <h2 class="mb-0" th:text="${totalFilms}">0</h2>
                                    </div>
                                    <div class="stat-icon bg-danger">
                                        <i class="bi bi-camera-reels"></i>
                                    </div>
                                </div>
                                <div class="mt-3">
                                    <a th:href="@{/admin/films}" class="text-danger text-decoration-none">
                                        Voir tous <i class="bi bi-arrow-right"></i>
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-xl-3 col-md-6">
                        <div class="card netflix-card text-light border-0 h-100">
                            <div class="card-body">
                                <div class="d-flex justify-content-between align-items-start">
                                    <div>
                                        <p class="text-muted mb-1">Total Salles</p>
                                        <h2 class="mb-0" th:text="${totalSalles}">0</h2>
                                    </div>
                                    <div class="stat-icon bg-primary">
                                        <i class="bi bi-door-open"></i>
                                    </div>
                                </div>
                                <div class="mt-3">
                                    <a th:href="@{/admin/salles}" class="text-primary text-decoration-none">
                                        Voir toutes <i class="bi bi-arrow-right"></i>
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-xl-3 col-md-6">
                        <div class="card netflix-card text-light border-0 h-100">
                            <div class="card-body">
                                <div class="d-flex justify-content-between align-items-start">
                                    <div>
                                        <p class="text-muted mb-1">Total Séances</p>
                                        <h2 class="mb-0" th:text="${totalSeances}">0</h2>
                                    </div>
                                    <div class="stat-icon bg-warning">
                                        <i class="bi bi-calendar-event"></i>
                                    </div>
                                </div>
                                <div class="mt-3">
                                    <a th:href="@{/seances}" class="text-warning text-decoration-none">
                                        Voir toutes <i class="bi bi-arrow-right"></i>
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-xl-3 col-md-6">
                        <div class="card netflix-card text-light border-0 h-100">
                            <div class="card-body">
                                <div class="d-flex justify-content-between align-items-start">
                                    <div>
                                        <p class="text-muted mb-1">Réservations</p>
                                        <h2 class="mb-0" th:text="${totalReservations}">0</h2>
                                    </div>
                                    <div class="stat-icon bg-success">
                                        <i class="bi bi-ticket-perforated"></i>
                                    </div>
                                </div>
                                <div class="mt-3">
                                    <span class="text-success">
                                        <i class="bi bi-arrow-up"></i> +12% ce mois
                                    </span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Two Column Layout -->
                <div class="row g-4">
                    <!-- Prochaines Séances -->
                    <div class="col-lg-8">
                        <div class="card netflix-card text-light border-0">
                            <div class="card-header bg-transparent border-bottom border-secondary d-flex justify-content-between align-items-center">
                                <h5 class="mb-0"><i class="bi bi-calendar-check me-2"></i>Prochaines Séances</h5>
                                <a th:href="@{/seances}" class="btn btn-sm btn-outline-danger">Voir tout</a>
                            </div>
                            <div class="card-body">
                                <div class="table-responsive">
                                    <table class="table table-dark table-hover">
                                        <thead>
                                            <tr>
                                                <th>Film</th>
                                                <th>Salle</th>
                                                <th>Date</th>
                                                <th>Heure</th>
                                                <th>Statut</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <tr th:each="seance : ${prochainesSeances}">
                                                <td>
                                                    <strong th:text="${seance.film.titre}">Titre du film</strong>
                                                </td>
                                                <td th:text="${seance.salle.nom}">Salle 1</td>
                                                <td th:text="${#temporals.format(seance.dateSeance, 'dd/MM/yyyy')}">15/01/2026</td>
                                                <td th:text="${#temporals.format(seance.heureDebut, 'HH:mm')}">14:00</td>
                                                <td>
                                                    <span class="badge bg-success">Disponible</span>
                                                </td>
                                            </tr>
                                            <tr th:if="${#lists.isEmpty(prochainesSeances)}">
                                                <td colspan="5" class="text-center text-muted">
                                                    <i class="bi bi-inbox fs-1 d-block mb-2"></i>
                                                    Aucune séance à venir
                                                </td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Films Récents -->
                    <div class="col-lg-4">
                        <div class="card netflix-card text-light border-0">
                            <div class="card-header bg-transparent border-bottom border-secondary d-flex justify-content-between align-items-center">
                                <h5 class="mb-0"><i class="bi bi-film me-2"></i>Films Récents</h5>
                                <a th:href="@{/admin/films/new}" class="btn btn-sm btn-danger">
                                    <i class="bi bi-plus-lg"></i> Ajouter
                                </a>
                            </div>
                            <div class="card-body">
                                <div class="list-group list-group-flush bg-transparent">
                                    <div th:each="film : ${filmsRecents}" 
                                         class="list-group-item bg-transparent text-light border-secondary d-flex justify-content-between align-items-center">
                                        <div class="d-flex align-items-center">
                                            <div class="film-thumbnail me-3">
                                                <i class="bi bi-film fs-2 text-danger"></i>
                                            </div>
                                            <div>
                                                <h6 class="mb-0" th:text="${film.titre}">Titre du film</h6>
                                                <small class="text-muted" th:text="${film.genre}">Genre</small>
                                            </div>
                                        </div>
                                        <a th:href="@{/admin/films/edit/{id}(id=${film.id})}" 
                                           class="btn btn-sm btn-outline-light">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                    </div>
                                    <div th:if="${#lists.isEmpty(filmsRecents)}" 
                                         class="list-group-item bg-transparent text-center text-muted border-0">
                                        <i class="bi bi-inbox fs-1 d-block mb-2"></i>
                                        Aucun film
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Bootstrap 5 JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    
    <!-- Custom JS -->
    <script>
        // Toggle sidebar
        document.getElementById('sidebarToggle').addEventListener('click', function() {
            document.getElementById('wrapper').classList.toggle('toggled');
        });
    </script>
</body>
</html>
